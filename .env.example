# Password for the dashboard. Required when it's on the internet.
APP_PASSWORD=change-me

# Your Claude subscription. On your own computer run `claude setup-token`
# and paste the token it prints here.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: model for edits (e.g. opus, sonnet). Blank = Claude Code default.
CLAUDE_MODEL=

# Speech-to-text (runs on the server with whisper.cpp, free).
# tiny / base / small / medium / large-v3-turbo; add ".en" for English-only (faster).
WHISPER_MODEL=small
# auto, en, hi, es, ...
WHISPER_LANGUAGE=auto
# Optional: transcribe with OpenAI's API instead of on the server.
OPENAI_API_KEY=

# Optional: your domain for automatic HTTPS (used by the caddy service).
DOMAIN=
